MONGO_URL=mongodb://localhost:27017
DB_NAME=orange
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
SEED_ENABLED=false

# Razorpay Standard Checkout (use Test Mode first)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Optional Razorpay Route linked-account payout.
# Each creator's user document can store razorpayLinkedAccountId after Route onboarding.

# Instagram OAuth
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/auth/instagram/callback
