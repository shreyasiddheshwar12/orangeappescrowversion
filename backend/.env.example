MONGO_URL=mongodb://localhost:27017
DB_NAME=orange
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000

# Razorpay Standard Checkout
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Set this to the webhook secret configured in Razorpay Dashboard
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Optional: Razorpay Route linked-account payout
# Store one account id per creator in the user document as razorpayLinkedAccountId.

# Instagram OAuth
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/auth/instagram/callback
